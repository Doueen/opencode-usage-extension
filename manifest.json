{
  "manifest_version": 3,
  "name": "OpenCode 用量监控",
  "version": "1.1.0",
  "description": "查看 opencode Go 订阅配额、实际用量明细（日/月 tokens）与 DeepSeek 余额",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://opencode.ai/*",
    "https://*.opencode.ai/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://opencode.ai/*", "https://*.opencode.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenCode 用量监控"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
